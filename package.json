{
  "name": "wormhole-gui",
  "version": "1.0.0",
  "description": "A beautiful GUI for magic-wormhole",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "download-binary": "node scripts/download-binary.js",
    "build": "electron-builder",
    "build:mac": "node scripts/download-binary.js mac && electron-builder --mac",
    "build:win": "node scripts/download-binary.js win && electron-builder --win --x64",
    "build:linux": "node scripts/download-binary.js linux && electron-builder --linux --x64",
    "build:all": "npm run build:mac && npm run build:win && npm run build:linux"
  },
  "keywords": ["wormhole", "file-transfer", "electron"],
  "author": {
    "name": "Wormhole",
    "email": "wormhole@example.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.wormhole.gui",
    "productName": "Wormhole",
    "directories": {
      "output": "dist"
    },
    "defaultArch": "x64",
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["zip"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": ["**/*"]
      }
    ]
  }
}
